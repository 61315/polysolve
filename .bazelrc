# Bazel configuration for PolySolve
common --enable_workspace

# Using C++ 17 on all platforms.
build:linux --host_cxxopt="-std=c++17"
build:macos --host_cxxopt="-std=c++17"
build:clang-cl --host_cxxopt="-std=c++17"
build:msvc-cl --host_cxxopt="/std:c++17"
build:windows --host_cxxopt="/std:c++17"
build:linux --cxxopt="-std=c++17"
build:macos --cxxopt="-std=c++17"
build:clang-cl --cxxopt="-std=c++17"
build:msvc-cl --cxxopt="/std:c++17"
build:windows --cxxopt="/std:c++17"
build:windows --cxxopt="/utf-8"
build:windows --color=yes
build:windows --enable_runfiles

# Build configurations
build:opt --compilation_mode=opt
build:opt --copt=-O3
build:opt --copt=-DNDEBUG
build:opt --strip=always

build:dbg --compilation_mode=dbg
build:dbg --copt=-g
build:dbg --strip=never

# Platform specific settings
build:linux --copt=-fPIC
build:linux --linkopt=-lpthread

build:macos --copt=-fPIC

# Sanitizer configurations
build:asan --config=dbg
build:asan --copt=-fsanitize=address
build:asan --linkopt=-fsanitize=address

build:tsan --config=dbg
build:tsan --copt=-fsanitize=thread
build:tsan --linkopt=-fsanitize=thread

build:ubsan --config=dbg
build:ubsan --copt=-fsanitize=undefined
build:ubsan --linkopt=-fsanitize=undefined

# Test configurations
test --test_output=errors
test --test_timeout=300,1200,3600,-1

# CI configuration
build:ci --verbose_failures
build:ci --show_timestamps
build:ci --announce_rc
build:ci --color=yes
build:ci --curses=no
build:ci --keep_going
build:ci --progress_report_interval=100
build:ci --show_progress_rate_limit=15
build:ci --ui_actions_shown=1024

# Coverage
coverage --combined_report=lcov
coverage --coverage_report_generator=@bazel_tools//tools/test:coverage_report_generator