# Use built-in cc rules

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Individual test targets for better granularity - separated to avoid main() conflicts
cc_test(
    name = "linear_solver_test",
    size = "medium",
    srcs = [
        "autodiff.h",
        "test_linear_solver.cpp",
    ],
    copts = [
        # "-std=c++17",
    ],
    data = [
        "//:linear-solver-spec.json",
        "@polyfem_data//:test_data",
    ],
    defines = [
        "POLYFEM_DATA_DIR=\\\"../polyfem_data\\\"",
    ],
    deps = [
        "//:polysolve_linear",
        "@catch2//:catch2_main",
        # "//:polysolve_with_amgcl",
    ],
)

cc_test(
    name = "nonlinear_solver_test",
    size = "medium",
    srcs = [
        "autodiff.h",
        "test_nonlinear_solver.cpp",
    ],
    copts = [
        # "-std=c++17",
    ],
    data = [
        "//:nonlinear-solver-spec.json",
        "@polyfem_data//:test_data",
    ],
    defines = [
        "POLYFEM_DATA_DIR=\\\"../polyfem_data\\\"",
    ],
    deps = [
        "//:polysolve",
        "@catch2//:catch2_main",
    ],
)

